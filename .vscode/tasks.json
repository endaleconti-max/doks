{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Auto Git Commit+Push",
			"type": "shell",
			"command": "./scripts/auto_commit_push.sh",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": true,
			"problemMatcher": [],
			"runOptions": {
				"runOn": "folderOpen"
			},
			"presentation": {
				"reveal": "never",
				"panel": "dedicated",
				"focus": false
			}
		},
		{
			"label": "Auto Start: Universal Build+Dev",
			"type": "shell",
			"command": "$HOME/.local/bin/vscode-auto-runner",
			"args": [
				"--mode",
				"dev"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": true,
			"problemMatcher": [],
			"runOptions": {
				"runOn": "folderOpen"
			},
			"presentation": {
				"reveal": "never",
				"panel": "dedicated",
				"focus": false
			}
		},
		{
			"label": "Kill and Relaunch App",
			"type": "shell",
			"command": "pkill -x DocumentOrganizerMacApp 2>/dev/null; sleep 1 && swift run DocumentOrganizerMacApp &",
			"isBackground": true,
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated",
				"focus": false
			}
		},
		{
			"label": "Kill App",
			"type": "shell",
			"command": "pkill -x DocumentOrganizerMacApp 2>/dev/null; echo 'App killed.'",
			"isBackground": false,
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated",
				"focus": false
			}
		},
		{
			"label": "Launch App",
			"type": "shell",
			"command": "swift run DocumentOrganizerMacApp &",
			"isBackground": true,
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated",
				"focus": false
			}
		},
		{
			"label": "Run DocumentOrganizer Samples",
			"type": "shell",
			"command": "swift package clean && swift run DocumentOrganizer ./samples/invoice.txt ./samples/resume.txt",
			"isBackground": false,
			"group": "test"
		},
		{
			"label": "Run Full Verification Suite",
			"type": "shell",
			"command": ".venv/bin/python scripts/verify_all.py --package-path . --output-json audit/full-verification-summary.json",
			"isBackground": false,
			"group": "test"
		},
		{
			"label": "Package macOS App Bundle",
			"type": "shell",
			"command": "./scripts/package_macos_app.sh",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Notarize macOS App Bundle",
			"type": "shell",
			"command": "./scripts/notarize_macos_app.sh",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Create macOS Release Artifacts",
			"type": "shell",
			"command": "./scripts/create_release_artifacts.sh",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Generate Release Manifest",
			"type": "shell",
			"command": "./scripts/generate_release_manifest.sh",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Publish GitHub Release (Dry Run)",
			"type": "shell",
			"command": "DRY_RUN=1 ./scripts/publish_github_release.sh",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Community Release (No Apple) - Dry Run",
			"type": "shell",
			"command": "RELEASE_CHANNEL=community ./scripts/create_release_artifacts.sh && ./scripts/generate_release_manifest.sh && ALLOW_COMMUNITY_RELEASE=1 DRY_RUN=1 ./scripts/publish_github_release.sh",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Community Release (No Apple) - Publish",
			"type": "shell",
			"command": "RELEASE_CHANNEL=community ./scripts/create_release_artifacts.sh && ./scripts/generate_release_manifest.sh && ALLOW_COMMUNITY_RELEASE=1 DRY_RUN=0 ./scripts/publish_github_release.sh",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Community Release (No Apple) - Publish (Warning Bypass)",
			"type": "shell",
			"command": "RELEASE_CHANNEL=community ./scripts/create_release_artifacts.sh && ./scripts/generate_release_manifest.sh && ALLOW_COMMUNITY_RELEASE=1 ALLOW_COMMUNITY_WARNING_BYPASS=1 DRY_RUN=0 ./scripts/publish_github_release.sh",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Generate Launch Evidence Packet",
			"type": "shell",
			"command": ".venv/bin/python scripts/generate_launch_evidence_packet.py --package-path .",
			"isBackground": false,
			"group": "test"
		}
	]
}